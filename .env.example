# 이 파일을 복사해 .env 로 저장한 뒤 실제 값을 채워 넣으세요.
# .env 는 절대 git 등 공유 저장소에 커밋하지 마세요.

ANTHROPIC_API_KEY=여기에_실제_API_키_입력
APP_PASSWORD=여기에_팀_로그인_비밀번호_입력

# backend/(FastAPI) 로그인 쿠키 서명용 비밀키 — 임의의 긴 무작위 문자열로 채우세요.
# 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=여기에_무작위_긴_문자열_입력
# 로컬(http)에서 테스트할 때만 false. 운영(https)에서는 반드시 true(기본값)여야 함.
COOKIE_SECURE=true
